-- Helper function for numerical integration
function integrate(func, range, step)
local x = tonumber(range[1])
local x_end = tonumber(range[2])
local area = 0
while x <= x_end do
area = area + func(x) * step
x = x + step
end
return area
end

-- Lua function for Normal Distribution
function normal_pdf(x, mean, std_dev)
local pi = math.pi
local exp = math.exp
return (1 / (std_dev * math.sqrt(2 * pi))) * exp(-0.5 * ((x - mean) / std_dev)^2)
end

function generate_normal_pdf(mean, std_dev, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = normal_pdf(x, mean, std_dev)
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

function generate_normal_cdf(mean, std_dev, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = integrate(function(t) return normal_pdf(t, mean, std_dev) end, {range[1], x}, step)
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

-- Lua function for Uniform Distribution
function uniform_pdf(x, a, b)
return (x >= a and x <= b) and (1 / (b - a)) or 0
end

function generate_uniform_pdf(a, b, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = uniform_pdf(x, a, b)
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

function generate_uniform_cdf(a, b, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = integrate(function(t) return uniform_pdf(t, a, b) end, {range[1], x}, step)
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

-- Lua function for Exponential Distribution
function exponential_pdf(x, lambda)
return (x >= 0) and (lambda * math.exp(-lambda * x)) or 0
end

function generate_exponential_pdf(lambda, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = exponential_pdf(x, lambda)
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

function generate_exponential_cdf(lambda, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = integrate(function(t) return exponential_pdf(t, lambda) end, {range[1], x}, step)
