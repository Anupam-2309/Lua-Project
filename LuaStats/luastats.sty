\begin{luacode*}
% =============================== 2 DATA ===============================

-- Advanced Statistical Analysis Class
local StatAnalysis = {}

-- Rounding function (moved outside the class)
function round(num, decimals)
local power = 10^decimals
return math.floor(num * power + 0.5) / power
end

-- Constructor for two datasets
function StatAnalysis.new(data1_str, data2_str)
local self = {
dataset1 = {},
dataset2 = {}
}

-- Parse first dataset
for num in string.gmatch(data1_str, "([^,]+)") do
local num_val = tonumber(num)
if num_val then
table.insert(self.dataset1, num_val)
else
error("Non-numeric value found in dataset1: " .. num)
end
end

-- Parse second dataset
for num in string.gmatch(data2_str, "([^,]+)") do
local num_val = tonumber(num)
if num_val then
table.insert(self.dataset2, num_val)
else
error("Non-numeric value found in dataset2: " .. num)
end
end

setmetatable(self, { __index = StatAnalysis })
return self
end

-- Utility functions
function StatAnalysis:validate_datasets()
if #self.dataset1 == 0 or #self.dataset2 == 0 then
error("Datasets cannot be empty")
end
if #self.dataset1 ~= #self.dataset2 then
error("Datasets must have equal length")
end
if #self.dataset1 < 2 then
error("Datasets must contain at least 2 elements")
end
end

function StatAnalysis:calculate_mean(dataset)
local sum = 0
for _, v in ipairs(dataset) do
sum = sum + v
end
return sum / #dataset
end

function StatAnalysis:calculate_variance(dataset)
local mean = self:calculate_mean(dataset)
local sum_sq_diff = 0
for _, v in ipairs(dataset) do
sum_sq_diff = sum_sq_diff + (v - mean)^2
end
return sum_sq_diff / (#dataset - 1)
end

-- Statistical Methods
function StatAnalysis:correlation()
self:validate_datasets()
local mean1 = self:calculate_mean(self.dataset1)
local mean2 = self:calculate_mean(self.dataset2)
local sum_xy, sum_x2, sum_y2 = 0, 0, 0

for i = 1, #self.dataset1 do
local x_diff = self.dataset1[i] - mean1
local y_diff = self.dataset2[i] - mean2
sum_xy = sum_xy + x_diff * y_diff
sum_x2 = sum_x2 + x_diff^2
sum_y2 = sum_y2 + y_diff^2
end

return round(sum_xy / math.sqrt(sum_x2 * sum_y2), 5)
end

function StatAnalysis:covariance()
self:validate_datasets()
local mean1 = self:calculate_mean(self.dataset1)
local mean2 = self:calculate_mean(self.dataset2)
local sum_cov = 0

for i = 1, #self.dataset1 do
sum_cov = sum_cov + (self.dataset1[i] - mean1) * (self.dataset2[i] - mean2)
end

return round(sum_cov / (#self.dataset1 - 1), 5)
end

function StatAnalysis:linear_regression()
self:validate_datasets()
local mean_x = self:calculate_mean(self.dataset1)
local mean_y = self:calculate_mean(self.dataset2)
local sum_xy, sum_x2 = 0, 0

for i = 1, #self.dataset1 do
local x_diff = self.dataset1[i] - mean_x
local y_diff = self.dataset2[i] - mean_y
sum_xy = sum_xy + x_diff * y_diff
sum_x2 = sum_x2 + x_diff^2
end

local slope = sum_xy / sum_x2
local intercept = mean_y - slope * mean_x

return round(slope, 5), round(intercept, 5)
end

-- Global registry for datasets
local stat_analyses = {}

-- LaTeX interface functions
function define_stat_analysis(name, data1_str, data2_str)
if stat_analyses[name] then
tex.print("Error: Dataset name already exists!")
return
end
stat_analyses[name] = StatAnalysis.new(data1_str, data2_str)
tex.print("Dataset " .. name .. " defined.")
end

function call_two_dataset_method(name, method)
local obj = stat_analyses[name]
if not obj then
tex.print("Error: Statistical analysis not found!")
return
end

local success, result1, result2 = pcall(function() return obj[method](obj) end)

if not success then
tex.print("Error: " .. tostring(result1))
return
end

-- Handle different method return scenarios
if method == "correlation" or method == "covariance" then
tex.print("Result: " .. tostring(result1))
elseif method == "linear_regression" then
tex.print(string.format("Slope: %.5f, Intercept: %.5f", result1, result2))
else
tex.print("Unsupported method!")
end
end

\end{luacode*}

\newcommand{\DefineStatAnalysis}[3]{%
\directlua{define_stat_analysis("#1", "#2", "#3")}%
}

\newcommand{\StatMethod}[2]{%
\directlua{call_two_dataset_method("#1", "#2")}%
}



