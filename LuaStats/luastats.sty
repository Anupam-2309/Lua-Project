-- Helper function to generate histogram data
function generate_histogram(data, bins, range)
local min_val = range[1]
local max_val = range[2]
local bin_width = (max_val - min_val) / bins
local hist = {}
for i = 1, bins do
hist[i] = 0
end
for _, value in ipairs(data) do
if value >= min_val and value <= max_val then
local bin_index = math.floor((value - min_val) / bin_width) + 1
if bin_index > bins then
bin_index = bins
end
hist[bin_index] = hist[bin_index] + 1
end
end
return hist, bin_width
end

-- Helper function to generate KDE-like smoothed curve
function generate_kde(data, range, step)
local coords = ""
local x = tonumber(range[1])
local x_end = tonumber(range[2])
while x <= x_end do
local y = 0
for _, value in ipairs(data) do
y = y + math.exp(-0.5 * ((x - value) / 0.2)^2) -- Gaussian kernel
end
coords = coords .. string.format("(%f,%f)", x, y)
x = x + step
end
tex.print(coords)
end

-- Function to generate distplot
function generate_distplot(data, bins, range, step)
local hist, bin_width = generate_histogram(data, bins, range)
local coords_hist = ""
for i = 1, bins do
local x = range[1] + (i - 1) * bin_width
local y = hist[i]
coords_hist = coords_hist .. string.format("(%f,%f)", x, y)
end
tex.print("\\addplot[ybar, fill=blue!30, draw=blue] coordinates {" .. coords_hist .. "};")
tex.print("\\addplot[smooth, thick, red] coordinates {" .. generate_kde(data, range, step) .. "};")
end
\end{luacode*}

