\begin{luacode*}
-- Define rounding function
function round(value, decimal_places)
if not value or type(value) ~= "number" then return 0 end
if not decimal_places then decimal_places = 5 end
local multiplier = 10 ^ decimal_places
return math.floor(value * multiplier + 0.5) / multiplier
end

-- Define dataset object with enhanced statistical methods
local Dataset = {}

function Dataset.new(data_str)
local self = { data = {} }
for num in string.gmatch(data_str, "([^,]+)") do
table.insert(self.data, tonumber(num))
end
setmetatable(self, { __index = Dataset })
return self
end

function Dataset:mean()
local sum = 0
local count = 0
for _, v in ipairs(self.data) do
sum = sum + v
count = count + 1
end
return round(sum / count, 3)
end

function Dataset:median()
local data = { table.unpack(self.data) }
table.sort(data)
local n = #data
if n % 2 == 1 then
return data[math.ceil(n / 2)]
else
return round((data[n / 2] + data[n / 2 + 1]) / 2, 3)
end
end

function Dataset:mode()
local counts = {}
for _, v in ipairs(self.data) do
counts[v] = (counts[v] or 0) + 1
end
local max_count = 0
local modes = {}
for k, v in pairs(counts) do
if v > max_count then
max_count = v
modes = { k }
elseif v == max_count then
table.insert(modes, k)
end
end
return table.concat(modes, ", ")
end

function Dataset:variance()
local avg = self:mean()
local sum = 0
for _, v in ipairs(self.data) do
sum = sum + (v - avg) ^ 2
end
return round(sum / #self.data, 5)
end

function Dataset:standard_deviation()
return round(math.sqrt(self:variance()), 5)
end

function Dataset:skewness()
local n = #self.data
local avg = self:mean()
local sd = self:standard_deviation()
local skew_sum = 0
for _, v in ipairs(self.data) do
skew_sum = skew_sum + ((v - avg) / sd) ^ 3
end
return round((n / ((n - 1) * (n - 2))) * skew_sum, 5)
end

function Dataset:kurtosis()
local n = #self.data
local avg = self:mean()
local sd = self:standard_deviation()
local kurt_sum = 0
for _, v in ipairs(self.data) do
kurt_sum = kurt_sum + ((v - avg) / sd) ^ 4
end
return round(((n * (n + 1)) / ((n - 1) * (n - 2) * (n - 3))) * kurt_sum - (3 * (n - 1) ^ 2) / ((n - 2) * (n - 3)), 5)
end

function Dataset:range()
local data = { table.unpack(self.data) }
table.sort(data)
return round(data[#data] - data[1], 5)
end

function Dataset:quartiles()
local data = { table.unpack(self.data) }
table.sort(data)
local n = #data
local q2 = self:median()
local q1, q3
if n % 2 == 0 then
q1 = Dataset.new(table.concat(data, ",", 1, n / 2)):median()
q3 = Dataset.new(table.concat(data, ",", n / 2 + 1)):median()
else
q1 = Dataset.new(table.concat(data, ",", 1, math.floor(n / 2))):median()
q3 = Dataset.new(table.concat(data, ",", math.ceil(n / 2) + 1)):median()
end
return q1, q2, q3
end

function Dataset:iqr()
local q1, _, q3 = self:quartiles()
return round(q3 - q1, 5)
end

-- Global datasets registry
local datasets = {}

function define_dataset(name, data_str)
datasets[name] = Dataset.new(data_str)
end

function call_method(name, method)
local obj = datasets[name]
if not obj then
tex.sprint("Dataset not found!")
return
end

if obj[method] then
-- Call the method and handle multiple or single return values
local success, result1, result2, result3 = pcall(obj[method], obj)
if not success then
tex.sprint("Error: " .. result1) -- Print any error message
return
end

if method == "quartiles" then
-- Handle quartiles specifically
tex.sprint(string.format("Q1: %.5f, Q2: %.5f, Q3: %.5f", result1, result2, result3))
else
-- Single return value or comma-separated values
tex.sprint(result1)
end
else
tex.sprint("Method not found!")
end
end

\end{luacode*}


