% Functions for advanced statistics: Skewness and Kurtosis
\begin{luacode*}
-- ================ Calculate skewness =========
function skewness(array)
local n = #array
local avg = mean(array)
local sd = standard_deviation(array)
local skew_sum = 0
for _, v in ipairs(array) do
skew_sum = skew_sum + ((v - avg) / sd) ^ 3
end
return (n / ((n - 1) * (n - 2))) * skew_sum
end

-- =========== Calculate kurtosis ===========
function kurtosis(array)
local n = #array
local avg = mean(array)
local sd = standard_deviation(array)
local kurt_sum = 0
for _, v in ipairs(array) do
kurt_sum = kurt_sum + ((v - avg) / sd) ^ 4
end
return ((n * (n + 1)) / ((n - 1) * (n - 2) * (n - 3))) * kurt_sum - (3 * (n - 1) ^ 2) / ((n - 2) * (n - 3))
end
\end{luacode*}

\newcommand{\luaSkewness}[1]{\directlua{tex.print(skewness({#1}))}}
\newcommand{\luaKurtosis}[1]{\directlua{tex.print(kurtosis({#1}))}}

% Correlation, covariance, linear regression, and t-test functions

\begin{luacode*}
-- ==========Compute Pearson correlation coefficient==============
function correlation(array1, array2)
local n = #array1
local mean1 = mean(array1)
local mean2 = mean(array2)
local sum_xy, sum_x2, sum_y2 = 0, 0, 0

for i = 1, n do
sum_xy = sum_xy + (array1[i] - mean1) * (array2[i] - mean2)
sum_x2 = sum_x2 + (array1[i] - mean1) ^ 2
sum_y2 = sum_y2 + (array2[i] - mean2) ^ 2
end

return round(sum_xy / math.sqrt(sum_x2 * sum_y2),5)
end

-- ========================Compute covariance====================
function covariance(array1, array2)
local n = #array1
local mean1 = mean(array1)
local mean2 = mean(array2)
local sum_cov = 0

for i = 1, n do
sum_cov = sum_cov + (array1[i] - mean1) * (array2[i] - mean2)
end

return round(sum_cov / (n - 1),5)
end

-- ==================Perform linear regression======================
function linear_regression(array_x, array_y)
local n = #array_x
local mean_x = mean(array_x)
local mean_y = mean(array_y)
local sum_xy, sum_x2 = 0, 0

for i = 1, n do
sum_xy = sum_xy + (array_x[i] - mean_x) * (array_y[i] - mean_y)
sum_x2 = sum_x2 + (array_x[i] - mean_x) ^ 2
end

local slope = sum_xy / sum_x2
local intercept = mean_y - slope * mean_x

return round(slope,5), round(intercept,5)
end

\end{luacode*}

