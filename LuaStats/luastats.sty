-- Helper for factorial calculation
local function factorial(n)
if n == 0 then return 1 end
local fact = 1
for i = 1, n do
fact = fact * i
end
return fact
end

-- Generate random numbers for Normal Distribution
function random_normal(mean, std_dev, n)
local pi = math.pi
local function box_muller()
local u1 = math.random()
local u2 = math.random()
local z0 = math.sqrt(-2 * math.log(u1)) * math.cos(2 * pi * u2)
return z0
end

local result = {}
for _ = 1, n do
local z = box_muller()
local value = mean + std_dev * z
table.insert(result, value)
end
return result
end

-- Generate random numbers for Uniform Distribution
function random_uniform(a, b, n)
local result = {}
for _ = 1, n do
local value = a + (b - a) * math.random()
table.insert(result, value)
end
return result
end

-- Generate random numbers for Exponential Distribution
function random_exponential(lambda, n)
local result = {}
for _ = 1, n do
local u = math.random()
local value = -math.log(1 - u) / lambda
table.insert(result, value)
end
return result
end

-- Generate random numbers for Binomial Distribution
function random_binomial(n, p, samples)
local result = {}
for _ = 1, samples do
local count = 0
for _ = 1, n do
if math.random() < p then
count = count + 1
end
end
table.insert(result, count)
end
return result
end

-- Generate random numbers for Poisson Distribution
function random_poisson(lambda, samples)
local result = {}
for _ = 1, samples do
local l = math.exp(-lambda)
local k = 0
local p = 1
repeat
k = k + 1
p = p * math.random()
until p <= l
table.insert(result, k - 1)
end
return result
end

-- Generate random numbers for Chi-square Distribution
function random_chisquare(df, samples)
local result = {}
for _ = 1, samples do
local sum = 0
for _ = 1, df do
local z = random_normal(0, 1, 1)[1]
sum = sum + z^2
end
table.insert(result, sum)
end
return result
end

-- Generate random numbers for t-Distribution
function random_t(df, samples)
local result = {}
for _ = 1, samples do
local z = random_normal(0, 1, 1)[1]
local chi = random_chisquare(df, 1)[1]
local value = z / math.sqrt(chi / df)
table.insert(result, value)
end
return result
end

-- Generate random numbers for F-Distribution
function random_f(df1, df2, samples)
local result = {}
for _ = 1, samples do
local chi1 = random_chisquare(df1, 1)[1] / df1
local chi2 = random_chisquare(df2, 1)[1] / df2
local value = chi1 / chi2
table.insert(result, value)
end
return result
end

-- Print Lua table as LaTeX-readable list
function print_random_numbers(numbers)
for _, num in ipairs(numbers) do
tex.sprint(string.format("%0.4f, ", num))
end
end
\end{luacode*}

