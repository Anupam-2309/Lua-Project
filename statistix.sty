\begin{luacode*}
-- ==============Rounding Function=============
function round(value, decimal_places)
    if not value or type(value) ~= "number" then return 0 end
    if not decimal_places then decimal_places = 5 end
    local multiplier = 10 ^ decimal_places
    return math.floor(value * multiplier + 0.5) / multiplier
end

-- ================Calculate the mean of an array============
function mean(array)
    if not array or #array == 0 then return 0 end
    local sum = 0
    local count = 0
    for _, v in ipairs(array) do
        if type(v) == "number" then
            sum = sum + v
            count = count + 1
        end
    end
    return count > 0 and round(sum / count) or 0
end

-- =================Calculate the median of an array=============
function median(array)
    if not array or #array == 0 then return 0 end
    local valid_nums = {}
    for _, v in ipairs(array) do
        if type(v) == "number" then
            table.insert(valid_nums, v)
        end
    end
    if #valid_nums == 0 then return 0 end
    
    table.sort(valid_nums)
    local n = #valid_nums
    if n % 2 == 1 then
        return valid_nums[math.floor((n + 1) / 2)]
    else
        return (valid_nums[n/2] + valid_nums[(n/2) + 1]) / 2
    end
end

-- ==================Calculate the mode of an array=================
function mode(array)
    if not array or #array == 0 then return {0} end
    local counts = {}
    local valid_count = 0
    
    -- Count occurrences
    for _, v in ipairs(array) do
        if type(v) == "number" then
            counts[v] = (counts[v] or 0) + 1
            valid_count = valid_count + 1
        end
    end
    
    if valid_count == 0 then return {0} end
    
    -- Find mode(s)
    local maxCount = 0
    local modes = {}
    for k, v in pairs(counts) do
        if v > maxCount then
            maxCount = v
            modes = {k}
        elseif v == maxCount then
            table.insert(modes, k)
        end
    end
    
    return modes
end

-- =====================Calculate the variance of an array================
function variance(array)
    local avg = mean(array)
    local sum = 0
    for _, v in ipairs(array) do
        sum = sum + (v - avg) ^ 2
    end
    return round(sum / #array,5)
end

-- ================Calculate the standard deviation of an array===============
function standard_deviation(array)
    return round(math.sqrt(variance(array)),5)
end

-- ===================Calculate the range of an array===============
function range(array)
    table.sort(array)
    return array[#array] - array[1]
end

-- ==============Calculate quartiles of an array===============
function quartiles(array)
    table.sort(array)
    local n = #array
    local Q2 = median(array)
    local Q1, Q3
    if n % 2 == 0 then
        Q1 = median({table.unpack(array, 1, n // 2)})
        Q3 = median({table.unpack(array, n // 2 + 1, n)})
    else
        Q1 = median({table.unpack(array, 1, (n - 1) // 2)})
        Q3 = median({table.unpack(array, (n + 3) // 2, n)})
    end
    return Q1, Q2, Q3
end

-- =================Calculate interquartile range (IQR)==============
function iqr(array)
    local q1, _, q3 = quartiles(array)
    return q3 - q1
end

\end{luacode*}

