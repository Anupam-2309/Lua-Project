        results.se_diff = paired_t_test({#3}, {#4})
        results.p_value = 0.05  -- You should calculate this properly
        tex.print(TableFormatter.new():t_test_style(results, 
        "Paired", "#1"))
    else
        results.t_stat, results.mean, results.variance, 
        results.se = one_sample_t_test({#3}, tonumber(#4))
        results.p_value = 0.05  -- You should calculate this properly
        tex.print(TableFormatter.new():t_test_style(results, 
        "One-Sample", "#1"))
    end
}%
