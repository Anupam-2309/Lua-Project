-- T-Test Results Table Style
function TableFormatter:t_test_style(results, test_type, caption)
    local output = [[
\begin{table}[htbp]
\centering
\begin{tcolorbox}[
    enhanced,
    title=\textbf{]] .. (caption or test_type .. " T-Test Results") .. [[},
    colback=white,
    colframe=blue!75!black,
    boxrule=0.5pt
]
\renewcommand{\arraystretch}{1.3}
\begin{tabular}{lc}
\toprule
\rowcolor{blue!10}\textbf{Statistic} & \textbf{Value} \\
\midrule
]]

    if test_type == "Independent" then
        output = output .. string.format([[
Mean (Group 1) & %.4f \\
Mean (Group 2) & %.4f \\
Variance (Group 1) & %.4f \\
Variance (Group 2) & %.4f \\
Pooled SE & %.4f \\
t-statistic & %.4f \\
p-value & %.4f \\
]], results.mean1, results.mean2, results.var1, results.var2, 
results.pooled_se, results.t_stat, results.p_value)
    elseif test_type == "Paired" then
        output = output .. string.format([[
Mean Difference & %.4f \\
Std Dev of Differences & %.4f \\
SE of Differences & %.4f \\
t-statistic & %.4f \\
p-value & %.4f \\
]], results.mean_diff, results.sd_diff, results.se_diff, 
results.t_stat, results.p_value)
    else -- One-sample
        output = output .. string.format([[
Sample Mean & %.4f \\
Sample Variance & %.4f \\
Standard Error & %.4f \\
t-statistic & %.4f \\
p-value & %.4f \\
]], results.mean, results.variance, results.se, 
results.t_stat, results.p_value)
    end

    output = output .. [[
\bottomrule
\end{tabular}
\end{tcolorbox}
\end{table}
]]
    return output
end

\end{luacode*}

