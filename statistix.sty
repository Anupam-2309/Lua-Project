% Function to load CSV file
\begin{luacode*}
-- Load CSV Function
function load_csv(filename)
    local file = io.open(filename, "r")
    if not file then
        tex.error("Could not open file: " .. filename)
        return {}
    end
    
    local data = {}
    for line in file:lines() do
        local row = {}
        for value in string.gmatch(line, "([^,]+)") do
            -- Try to convert to number, use 0 if fails
            local num = tonumber(value)
            if num then
                table.insert(row, num)
            else
                -- Handle non-numeric values
                tex.print("Warning: Non-numeric value found in CSV: " .. value)
                table.insert(row, 0)
            end
        end
        if #row > 0 then
            table.insert(data, row)
        end
    end
    file:close()
    return data
end

-- Advanced Statistics for CSV Columns
function advanced_statistics_csv(filename)
    local data = load_csv(filename)
    if #data == 0 then
        tex.print("Error: No data found in the CSV file.")
        return ""
    end

    local results = {}

    -- Start LaTeX table with color enhancements
    local table_output = "\\renewcommand\\arraystretch{1.5}\\setlength\\tabcolsep{3pt}\\small\\rowcolors{2}{gray!10}{white}\\begin{tabular}{ccccccc}\\hline\n"
    table_output = table_output .. "\\rowcolor{gray!25}\\textbf{Column} & \\textbf{Mean} & \\textbf{Median} & \\textbf{Mode} & \\textbf{Variance} & \\textbf{Std Dev} & \\textbf{Range} \\\\"

    -- Compute statistics for each column
    for col = 1, #data[1] do
        local column_data = {}
        for row = 1, #data do
            table.insert(column_data, data[row][col])
        end

        -- Calculate statistics
        local mean_val = mean(column_data) or 0
        local median_val = median(column_data) or 0
        local mode_val = table.concat(mode(column_data) or {"N/A"}, ", ")
        local variance_val = variance(column_data) or 0
        local sd_val = standard_deviation(column_data) or 0
        local range_val = range(column_data) or 0

        -- Format row for LaTeX table
        table_output = table_output .. string.format(
            "%d & %.2f & %.2f & %s & %.2f & %.2f & %.2f \\\\\n",
            col, mean_val, median_val, mode_val, variance_val, sd_val, range_val
        )
    end

    -- End LaTeX table without an extra empty row
    table_output = table_output .."\\end{tabular}"
    return table_output
end
\end{luacode*}

