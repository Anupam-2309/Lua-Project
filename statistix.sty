% =================== Statistics Class ===================
Statistics = {}
Statistics.__index = Statistics

% Constructor
function Statistics.new(data)
    local self = setmetatable({}, Statistics)
    self.data = type(data) == "table" and data or {}
    self:validate()
    return self
end

% Data validation and cleaning
function Statistics:validate()
    local valid_data = {}
    for _, v in ipairs(self.data) do
        if type(v) == "number" then
            table.insert(valid_data, v)
        end
    end
    self.data = valid_data
    self.n = #valid_data
end

% Basic statistics methods
function Statistics:mean()
    if self.n == 0 then return 0 end
    local sum = 0
    for _, v in ipairs(self.data) do
        sum = sum + v
    end
    return round(sum / self.n)
end

function Statistics:median()
    if self.n == 0 then return 0 end
    local sorted = {}
    for i, v in ipairs(self.data) do
        sorted[i] = v
    end
    table.sort(sorted)
    
    if self.n % 2 == 1 then
        return sorted[math.floor((self.n + 1) / 2)]
    else
        return (sorted[self.n/2] + sorted[self.n/2 + 1]) / 2
    end
end

function Statistics:variance()
    if self.n < 2 then return 0 end
    local m = self:mean()
    local sum_sq = 0
    for _, v in ipairs(self.data) do
        sum_sq = sum_sq + (v - m)^2
    end
    return round(sum_sq / (self.n - 1))
end

function Statistics:std_dev()
    return round(math.sqrt(self:variance()))
end

function Statistics:summary()
    return {
        n = self.n,
        mean = self:mean(),
        median = self:median(),
        variance = self:variance(),
        std_dev = self:std_dev(),
        min = self.n > 0 and math.min(table.unpack(self.data)) or 0,
        max = self.n > 0 and math.max(table.unpack(self.data)) or 0
    }
end

% Advanced statistics methods
function Statistics:skewness()
    if self.n < 3 then return 0 end
    local m = self:mean()
    local s = self:std_dev()
    if s == 0 then return 0 end
    
    local sum_cubed = 0
    for _, v in ipairs(self.data) do
        sum_cubed = sum_cubed + ((v - m)/s)^3
    end
    return round((self.n / ((self.n-1) * (self.n-2))) * sum_cubed)
end

function Statistics:kurtosis()
    if self.n < 4 then return 0 end
    local m = self:mean()
    local s = self:std_dev()
    if s == 0 then return 0 end
    
    local sum_fourth = 0
    for _, v in ipairs(self.data) do
        sum_fourth = sum_fourth + ((v - m)/s)^4
    end
    return round(((self.n * (self.n+1)) / ((self.n-1) * (self.n-2) * (self.n-3))) * sum_fourth - 
                (3 * (self.n-1)^2) / ((self.n-2) * (self.n-3)))
end

% Statistical tests
function Statistics:t_test(mu0)
    if self.n < 2 then return 0 end
    local se = self:std_dev() / math.sqrt(self.n)
    if se == 0 then return 0 end
    return round((self:mean() - mu0) / se)
end

% Confidence intervals
function Statistics:confidence_interval(confidence_level)
    if self.n < 2 then return 0, 0 end
    local alpha = 1 - confidence_level
    % Note: This is a simplified version using normal distribution
    local z = 1.96 -- for 95% confidence level
    local se = self:std_dev() / math.sqrt(self.n)
    local mean = self:mean()
    return round(mean - z * se), round(mean + z * se)
end

% Hypothesis testing
function Statistics:z_test(mu0, population_sd)
    if self.n < 1 then return 0 end
    local se = population_sd / math.sqrt(self.n)
    if se == 0 then return 0 end
    return round((self:mean() - mu0) / se)
end

\end{luacode*}

% Add these new LaTeX commands to use the Statistics class
\newcommand{\StatsSummary}[1]{%
\directlua{
    local stats = Statistics.new({#1})
    local summary = stats:summary()
    tex.print("\\begin{tabular}{lr}")
    tex.print("\\hline")
    tex.print("Statistic & Value \\\\")
    tex.print("\\hline")
    tex.print(string.format("N & %d \\\\", summary.n))
    tex.print(string.format("Mean & %.4f \\\\", summary.mean))
    tex.print(string.format("Median & %.4f \\\\", summary.median))
    tex.print(string.format("Std Dev & %.4f \\\\", summary.std_dev))
    tex.print(string.format("Variance & %.4f \\\\", summary.variance))
    tex.print(string.format("Minimum & %.4f \\\\", summary.min))
    tex.print(string.format("Maximum & %.4f \\\\", summary.max))
    tex.print("\\hline")
    tex.print("\\end{tabular}")
}%
}

\newcommand{\StatsCI}[2]{%
\directlua{
    local stats = Statistics.new({#1})
    local lower, upper = stats:confidence_interval(#2)
    tex.print(string.format("(%.4f, %.4f)", lower, upper))
}%
}

\newcommand{\StatsTTest}[2]{%
\directlua{
    local stats = Statistics.new({#1})
    local t_stat = stats:t_test(#2)
    tex.print(string.format("t = %.4f", t_stat))
}%
}

% =================== Table Formatting Classes ===================
\begin{luacode*}
-- Table Formatting Class
TableFormatter = {}
TableFormatter.__index = TableFormatter

function TableFormatter.new()
    local self = setmetatable({}, TableFormatter)
    return self
end

-- Student-friendly colorful table style
function TableFormatter:student_style(data, headers, caption)
    local output = [[
\begin{table}[htbp]
\centering
\renewcommand{\arraystretch}{1.3}
\begin{tcolorbox}[
    colback=white,
    colframe=blue!75!black,
    arc=0mm,
    boxrule=0.5pt,
    title=\textbf{]] .. (caption or "Statistical Results") .. [[}
]
    output = output .. [[\begin{tabular}{|]] .. string.rep("c|", #headers) .. [[}
\hline
\rowcolor{blue!20} ]] .. table.concat(headers, " & ") .. [[ \\
\hline
]]
    
    -- Add data rows with alternating colors
    for i, row in ipairs(data) do
        if i % 2 == 0 then
            output = output .. "\\rowcolor{gray!10}"
        end
        output = output .. table.concat(row, " & ") .. " \\\\\n\\hline\n"
    end
    
    output = output .. [[
\end{tabular}
\end{tcolorbox}
\end{table}
]]
    return output
end

-- Professional research table style
function TableFormatter:research_style(data, headers, caption)
    local output = [[
\begin{table}[htbp]
\centering
\renewcommand{\arraystretch}{1.2}
\begin{threeparttable}
\caption{]] .. (caption or "Statistical Analysis Results") .. [[}
\begin{tabular}{]] .. string.rep("l", #headers) .. [[}
\toprule
\textbf{]] .. table.concat(headers, "} & \\textbf{") .. [[} \\
\midrule
]]
    
    -- Add data rows
    for i, row in ipairs(data) do
        output = output .. table.concat(row, " & ") .. " \\\\\n"
    end
    
    output = output .. [[
\bottomrule
\end{tabular}
\begin{tablenotes}[flushleft]
\small
\item Note: Values are rounded to 4 decimal places.
\end{tablenotes}
\end{threeparttable}
\end{table}
]]
    return output
end

-- Modern compact table style
function TableFormatter:compact_style(data, headers, caption)
    local output = [[
\begin{table}[htbp]
\centering
\renewcommand{\arraystretch}{1.1}
\begin{tcolorbox}[
    enhanced,
    sharp corners,
    colback=white,
    colframe=black!50,
    boxrule=0.5pt
]
\caption*{\textbf{]] .. (caption or "Statistical Summary") .. [[}}
\begin{tabular}{@{}]] .. string.rep("l", #headers) .. [[}
\toprule
]] .. table.concat(headers, " & ") .. [[ \\
\midrule
]]
    
    -- Add data rows
    for i, row in ipairs(data) do
        output = output .. table.concat(row, " & ") .. " \\\\\n"
    end
    
    output = output .. [[
\bottomrule
\end{tabular}
\end{tcolorbox}
\end{table}
]]
    return output
end

