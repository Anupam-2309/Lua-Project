end

-- Two-Way ANOVA in Lua
function two_way_anova(data)
    -- Calculate grand mean
    local a = #data
    local b = #data[1]
    
    local total_sum, total_count = 0, 0
    for _, row in ipairs(data) do
        for _, value in ipairs(row) do
            total_sum = total_sum + value
            total_count = total_count + 1
        end
    end
    local grand_mean = total_sum / total_count
    local C = total_sum^2/total_count
    
    -- Initialize sum of squares
    local SSA, SSB, SSE = 0, 0, 0

    --SST
    local SS = 0
    for _,row in ipairs(data) do 
        for _,value in ipairs(row) do
            SS = SS + value^2
        end
    end
    local SST = SS - C

    -- Calculate row sums
    local row_sums = {}
    for i, row in ipairs(data) do
        local sum = 0
        for _, value in ipairs(row) do
            sum = sum + value
        end
        table.insert(row_sums, sum)
    end
    
    -- Calculate column sums
    local col_sums = {}
    local num_cols = #data[1]
    for j = 1, num_cols do
        local sum = 0
        for i = 1, #data do
            sum = sum + data[i][j]
        end
        table.insert(col_sums, sum)
    end
    
    -- SSA
    local ssa = 0
    for _,i in ipairs(row_sums) do 
        ssa = ssa + (i^2)/b
    end
    SSA = ssa - C

    -- SSB
    local ssb = 0
    for _,i in ipairs(col_sums) do 
        ssb = ssb + (i^2)/a
    end
    SSB = ssb - C
    SSE = SST - SSA -SSB

    -- Degrees of freedom
    local df_A = a-1
    local df_B = b-1
    local df_total = total_count -1
    local df_within = df_total - df_A - df_B 
    
    -- Mean squares
    local MSA = SSA / df_A
    local MSB = SSB / df_B
    local MSE = SSE / df_within
    
    -- F-statistics
    local F_A = MSA / MSE
    local F_B = MSB / MSE
    
    -- Return results
    return {
        SSA = round(SSA,5), SSB = round(SSB,5), SST = round(SST,5), SSE = round(SSE,5),
        df_A = df_A, df_B = df_B, df_within = df_within, df_total = df_total,
        MSA =round(MSA,5), MSB = round(MSB,5), MSE = round(MSE,5),
        F_A = round(F_A,5), F_B = round(F_B,5)
    }
end

\end{luacode*}

