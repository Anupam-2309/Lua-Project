% ==================ANOVA =====================
\begin{luacode*}
function one_way_anova(data)
    -- Input validation
    if not data or #data < 2 then
        return nil, "Need at least 2 groups"
    end
    
    local total_sum, total_count = 0, 0
    for _, group in ipairs(data) do
        if #group < 1 then return nil, "Empty group found" end
        for _, value in ipairs(group) do
            if type(value) ~= "number" then
                return nil, "Non-numeric value found"
            end
            total_sum = total_sum + value
            total_count = total_count + 1
        end
    end
    
    -- Rest of calculation with improved precision
    local grand_mean = total_sum / total_count
    local SSB, SSE = 0, 0
    for _, group in ipairs(data) do
        local group_sum = 0
        for _, value in ipairs(group) do
            group_sum = group_sum + value
        end
        local group_mean = group_sum / #group
        SSB = SSB + #group * (group_mean - grand_mean)^2
        for _, value in ipairs(group) do
            SSE = SSE + (value - group_mean)^2
        end
    end
    
    local df_between = #data - 1
    local df_within = total_count - #data
    local MSB = round(SSB / df_between,5)
    local MSE = round(SSE / df_within,5)
    local F = round(MSB / MSE,5)
    
    return {
        SSB = round(SSB,5),
        SSE = round(SSE,5),
        df_between = df_between,
        df_within = df_within,
        MSB = MSB,
        MSE = MSE,
        F = F
    }
end

-- Two-Way ANOVA in Lua
function two_way_anova(data)
    -- Calculate grand mean
    local a = #data
    local b = #data[1]
    
    local total_sum, total_count = 0, 0
    for _, row in ipairs(data) do
        for _, value in ipairs(row) do
            total_sum = total_sum + value
            total_count = total_count + 1
        end
    end
    local grand_mean = total_sum / total_count
    local C = total_sum^2/total_count
    
    -- Initialize sum of squares
    local SSA, SSB, SSE = 0, 0, 0

    --SST
    local SS = 0
    for _,row in ipairs(data) do 
        for _,value in ipairs(row) do
            SS = SS + value^2
        end
    end
    local SST = SS - C

    -- Calculate row sums
    local row_sums = {}
    for i, row in ipairs(data) do
        local sum = 0
        for _, value in ipairs(row) do
            sum = sum + value
        end
        table.insert(row_sums, sum)
    end
    
    -- Calculate column sums
    local col_sums = {}
    local num_cols = #data[1]
    for j = 1, num_cols do
        local sum = 0
        for i = 1, #data do
            sum = sum + data[i][j]
        end
        table.insert(col_sums, sum)
    end
    
    -- SSA
    local ssa = 0
    for _,i in ipairs(row_sums) do 
        ssa = ssa + (i^2)/b
    end
    SSA = ssa - C

    -- SSB
    local ssb = 0
    for _,i in ipairs(col_sums) do 
        ssb = ssb + (i^2)/a
    end
    SSB = ssb - C
    SSE = SST - SSA -SSB

    -- Degrees of freedom
    local df_A = a-1
    local df_B = b-1
    local df_total = total_count -1
    local df_within = df_total - df_A - df_B 
    
    -- Mean squares
    local MSA = SSA / df_A
    local MSB = SSB / df_B
    local MSE = SSE / df_within
    
    -- F-statistics
    local F_A = MSA / MSE
    local F_B = MSB / MSE
    
    -- Return results
    return {
        SSA = round(SSA,5), SSB = round(SSB,5), SST = round(SST,5), SSE = round(SSE,5),
        df_A = df_A, df_B = df_B, df_within = df_within, df_total = df_total,
        MSA =round(MSA,5), MSB = round(MSB,5), MSE = round(MSE,5),
        F_A = round(F_A,5), F_B = round(F_B,5)
    }
end

\end{luacode*}

\newcommand{\OneWayANOVA}[1]{%
  \directlua{
    local result = one_way_anova(#1)
    tex.print("\\\\")
    tex.print("\\begin{tabular}{p{4cm}p{2cm}p{1cm}p{2cm}p{1cm}}")
    tex.print("\\hline \\hline")
    tex.print("\\textbf{Statistic} & \\textbf{Sum of Squares} & \\textbf{df} & \\textbf{Mean Square} & \\textbf{F} \\\\ \\hline")
    tex.print("Groups & " .. result.SSB .. " & ".. result.df_between .. " & ".. result.MSB .. " & ".. result.F .. "\\\\")
    tex.print("Error & " .. result.SSE .. " & ".. result.df_within .. " & ".. result.MSE .. "\\\\")
    tex.print("\\hline")
    tex.print("Total & " .. result.SSE+result.SSB .. " & ".. result.df_within+result.df_between .. "\\\\")
    tex.print("\\end{tabular}")
    tex.print("\\\\")
  }
}

\newcommand{\TwoWayANOVA}[1]{%
  \directlua{
    local result = two_way_anova(#1)
    tex.print("\\begin{tabular}{p{4cm}p{2cm}p{1cm}p{2cm}p{1cm}}")
    tex.print("\\hline \\hline")
    tex.print("\\textbf{Source of Variation} & \\textbf{Sum of Squares} & \\textbf{df} & \\textbf{Mean Square} & \\textbf{F} \\\\ \\hline")
    tex.print("Factor A & " .. result.SSA .. " & ".. result.df_A .. " & ".. result.MSA .. " & ".. result.F_A .. "\\\\")
    tex.print("Factor B & " .. result.SSB .. " & ".. result.df_B .. " & ".. result.MSB .. " & ".. result.F_B .. "\\\\")
    tex.print("Error & " .. result.SSE .. " & ".. result.df_within .. " & ".. result.MSE .."\\\\")
    tex.print("\\hline")
    tex.print("Total & " .. result.SST .. " & ".. result.df_total .. "\\\\")
    tex.print("\\end{tabular}")
  }
}

%=================== Loading CSV data and summarizing it=================
% Function to load CSV file
\begin{luacode*}
-- Load CSV Function
function load_csv(filename)
    local file = io.open(filename, "r")
    local data = {}
    if file then
        for line in file:lines() do
            local row = {}
            for num in string.gmatch(line, "([^,]+)") do
                table.insert(row, tonumber(num) or 0)  -- Handle non-numeric values gracefully
            end
            table.insert(data, row)
        end
        file:close()
    else
        tex.print("Error: Could not open file " .. filename)
    end
    return data
end

-- Advanced Statistics for CSV Columns
function advanced_statistics_csv(filename)
    local data = load_csv(filename)
    if #data == 0 then
        tex.print("Error: No data found in the CSV file.")
        return ""
    end

    local results = {}

    -- Start LaTeX table with color enhancements
    local table_output = "\\renewcommand\\arraystretch{1.5}\\setlength\\tabcolsep{3pt}\\small\\rowcolors{2}{gray!10}{white}\\begin{tabular}{ccccccc}\\hline\n"
    table_output = table_output .. "\\rowcolor{gray!25}\\textbf{Column} & \\textbf{Mean} & \\textbf{Median} & \\textbf{Mode} & \\textbf{Variance} & \\textbf{Std Dev} & \\textbf{Range} \\\\"

    -- Compute statistics for each column
    for col = 1, #data[1] do
        local column_data = {}
        for row = 1, #data do
            table.insert(column_data, data[row][col])
        end

        -- Calculate statistics
        local mean_val = mean(column_data) or 0
        local median_val = median(column_data) or 0
        local mode_val = table.concat(mode(column_data) or {"N/A"}, ", ")
        local variance_val = variance(column_data) or 0
        local sd_val = standard_deviation(column_data) or 0
        local range_val = range(column_data) or 0

        -- Format row for LaTeX table
        table_output = table_output .. string.format(
            "%d & %.2f & %.2f & %s & %.2f & %.2f & %.2f \\\\\n",
            col, mean_val, median_val, mode_val, variance_val, sd_val, range_val
        )
    end

    -- End LaTeX table without an extra empty row
    table_output = table_output .."\\end{tabular}"
    return table_output
end
\end{luacode*}

\newcommand{\CSVsummary}[1]{%
    \directlua{
        local table_output = advanced_statistics_csv("#1")
        tex.print(table_output)
    }
}





