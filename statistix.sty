% Convenience command for statistical summary tables
\newcommand{\StatsSummaryTable}[2][student]{%
\directlua{
    local stats = Statistics.new({#2})
    local summary = stats:summary()
    local headers = {"Statistic", "Value"}
    local data = {
        {"N", string.format("%d", summary.n)},
        {"Mean", string.format("%.4f", summary.mean)},
        {"Median", string.format("%.4f", summary.median)},
        {"Std Dev", string.format("%.4f", summary.std_dev)},
        {"Variance", string.format("%.4f", summary.variance)},
        {"Minimum", string.format("%.4f", summary.min)},
        {"Maximum", string.format("%.4f", summary.max)}
    }
    
    local formatter = TableFormatter.new()
    if "#1" == "student" then
        tex.print(formatter:student_style(data, headers, "Statistical Summary"))
    elseif "#1" == "research" then
        tex.print(formatter:research_style(data, headers, "Statistical Analysis Results"))
    else
        tex.print(formatter:compact_style(data, headers, "Summary Statistics"))
    end
}%
}

