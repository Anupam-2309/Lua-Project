% Chi-Square Test and ANOVA functions
\begin{luacode*}
-- =========================Chi-Square Test==============
function chi_square(observed, expected)
    local sum = 0
    for i = 1, #observed do
        local diff = observed[i] - expected[i]
        sum = sum + (diff ^ 2 / expected[i])
    end
    return round(sum,5)
end

-- ==================Exponential Moving Average (EMA)============
function exponential_moving_average(array, alpha)
    local ema = array[1] -- Start EMA with the first element
    for i = 2, #array do
        ema = alpha * array[i] + (1 - alpha) * ema
    end
    return ema
end

--=================== Weighted Mean=====================
function weighted_mean(array, weights)
    local sum_weighted_values = 0
    local sum_weights = 0
    for i = 1, #array do
        sum_weighted_values = sum_weighted_values + array[i] * weights[i]
        sum_weights = sum_weights + weights[i]
    end
    return sum_weighted_values / sum_weights
end

--=================== Z-Scores=================
function z_scores(array)
    local avg = mean(array)
    local sd = standard_deviation(array)
    local z_scores_array = {}
    for _, v in ipairs(array) do
        table.insert(z_scores_array, round((v - avg)/sd,5))
    end
    return z_scores_array
end

\end{luacode*}

