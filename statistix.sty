	tex.print("t-Statistic & " .. t_statistic .. " \\\\ \\hline")
	tex.print("\\end{tabular}") % ============== Independent ============
	elseif test_type == "paired" then
	t_statistic, mean_diff, variance_diff, se = paired_t_test(data1, data2_or_population_mean)
	tex.print("\\begin{tabular}{p{7cm}p{5cm}}")
